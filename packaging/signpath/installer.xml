<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer" (stage 2 of .github/workflows/release.yml).
     Input: a zip with the single NSIS installer kvalah-<version>-win-x64-setup.exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="kvalah-*-win-x64-setup.exe" product-name="kvalah" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
