{
  "name": "kvalah",
  "productName": "kvalah",
  "desktopName": "kvalah.desktop",
  "version": "0.7.0",
  "description": "Reliable local coding agent for open models (Ollama, LM Studio, llama.cpp, vLLM) on a single home GPU",
  "license": "MIT",
  "author": {
    "name": "Enver Abdullaev",
    "email": "AranAragan@users.noreply.github.com"
  },
  "homepage": "https://github.com/AranAragan/kvalah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AranAragan/kvalah.git"
  },
  "bugs": {
    "url": "https://github.com/AranAragan/kvalah/issues"
  },
  "private": true,
  "type": "module",
  "main": "desktop.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "test": "node --test --test-timeout=120000 test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
